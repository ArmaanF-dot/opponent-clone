# Copy to .env (gitignored) and fill in. Never commit the real file.
# Optional: raises Lichess rate limits. Create at https://lichess.org/account/oauth/token (no scopes needed for public games).
LICHESS_API_TOKEN=your_lichess_token_here
# Chess.com public API needs no key, but asks for a contact in the User-Agent.
CONTACT_EMAIL=you@example.com
